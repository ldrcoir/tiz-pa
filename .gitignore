# ═══════════════════════════════════════════════════════════
#  گیت‌ایگنورِ تیزپا — دفترچهٔ مرتب‌کاری
#  قاعده: در گیت فقط ema (چیزهای کاربر) + to (آزمایشگاه) + scripts/key
#  همهٔ چیزهای دیگرِ ریشه، ابزار یا زبالهٔ لوکال سندباکس است
# ═══════════════════════════════════════════════════════════

# گودوت
.godot/
android/build/
*.tmp

# خروجی‌های ساخت و پوشه‌های دانلود — هرگز وارد گیت نمی‌شوند
build/
download/
dl/
upload/

# ابزارهای سنگینِ لوکال (گودوت، جاوا، مدل‌ها)
tools/

# فضای کاریِ توسعهٔ بازی — نسخهٔ اصلی همیشه در ema/tizpa است
game/

# داربستِ Next.js سندباکس — ربطی به بازی ندارد
db/
examples/
mini-services/
prisma/
public/
src/
tests/
package.json
bun.lock
components.json
next-env.d.ts
next.config.ts
postcss.config.mjs
tailwind.config.ts
tsconfig.json
eslint.config.mjs
Caddyfile
server.log

# بقیهٔ پروژه‌های آزمایشیِ قدیمیِ لوکال (تاریخِ گیت نسخه‌هایشان را دارد)
demos/
docs/
noor2d/
tizpa2d/
worklog.md

# اسکریپت‌های کمکیِ سیستم
.zscripts/
tool-results/

# داخلِ scripts فقط فایل‌های .py/.sh/.mjs کلیدی ردیابی می‌شوند؛
# عکس‌ها و لاگ‌ها و پژوهش‌های تولیدشده زبالهٔ کارگاه‌اند
/scripts/*.png
/scripts/*.jpg
/scripts/*.log
/scripts/*.json
/scripts/bazaar/
/scripts/research/
/scripts/face_edit/
/scripts/face_edit2.mjs
/scripts/orig_v1/
/scripts/sprites_raw/
/scripts/sprites_raw_v2/
/scripts/sprites_raw_v3/
/scripts/game_parts/

# کلید و رمز — مقدس
keys/
.env
*.keystore
